.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 区域1样式 */
.header {
  padding: 32rpx 32rpx 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 区域2样式 */
.plans-section {
  flex: 1;
  padding: 0 32rpx;
  overflow: hidden;
  margin-bottom: 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 32rpx;
  display: block;
}

.marquee-container {
  height: 680rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 24rpx;
  touch-action: pan-x;
}

.marquee-row {
  position: relative;
  display: flex;
  white-space: nowrap;
  animation: marquee linear infinite;
  touch-action: pan-x;
  height: 92rpx;
}

.marquee-row.paused {
  animation-play-state: paused;
}

.plan-items {
  display: inline-flex;
  will-change: transform;
}

.marquee-row.reverse {
  animation: marquee-reverse linear infinite;
}

@keyframes marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

@keyframes marquee-reverse {
  from {
    transform: translateX(-50%);
  }
  to {
    transform: translateX(0);
  }
}

.plan-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  height: 72rpx;
  padding: 0 28rpx;
  margin: 0 16rpx;
  border-radius: 36rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  color: #333;
  transition: all 0.3s;
}

.plan-item.active {
  background: #000;
  color: #fff;
}

/* 区域3样式 */
.custom-section {
  padding: 32rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  margin-top: auto;
}

.custom-input-wrapper {
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.custom-input {
  flex: 1;
  height: 88rpx;
  padding: 0 32rpx;
  background: #f5f5f5;
  border-radius: 44rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.confirm-btn {
  width: 88rpx;
  height: 88rpx;
  padding: 22rpx;
  background: #f5f5f5;
  border-radius: 44rpx;
  box-sizing: border-box;
}

.confirm-btn:active {
  background: #eee;
}

.submit-btn {
  width: 240rpx;
  height: 80rpx;
  background: #000;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn-container {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
} 