.container {
  min-height: 100vh;
  padding: 32rpx;
  background: #f8f8f8;
}

.header {
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.history-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.item-content {
  display: flex;
  gap: 24rpx;
  position: relative;
}

.item-poster {
  width: 180rpx;
  height: 240rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.item-right {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 8rpx 0;
}

.item-time {
  font-size: 26rpx;
  color: #999;
}

/* 删除图标样式 */
.delete-icon {
  width: 40rpx;
  height: 40rpx;
  padding: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.6;
}

.delete-icon .icon {
  width: 32rpx;
  height: 32rpx;
}

.icon-hover {
  opacity: 1;
  transform: scale(1.1);
}

/* 移除旧的按钮样式 */
.item-actions,
.action-btn {
  display: none;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.create-btn {
  width: 240rpx;
  height: 80rpx;
  background: #000;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
  gap: 16rpx;
}

.loading-icon {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #333;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 添加计划内容的样式 */
.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-plans {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.plan-item {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
} 