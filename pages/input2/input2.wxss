.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  padding: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.templates-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.template-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid #eee;
  transition: all 0.3s;
}

.template-item.active {
  border-color: #000;
  background: rgba(0,0,0,0.05);
}

.template-preview {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
}

.template-item.coming-soon .template-preview {
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}

.template-name {
  font-size: 28rpx;
  color: #333;
}

.generate-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #000;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  margin-top: auto;
} 